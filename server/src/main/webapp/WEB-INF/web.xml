<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.1">
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Translation API</web-resource-name>
            <url-pattern>/api/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>**</role-name>
        </auth-constraint>
    </security-constraint>
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Public health check</web-resource-name>
            <url-pattern>/api/health</url-pattern>
        </web-resource-collection>
    </security-constraint>
</web-app>
